<Window x:Class="NoveNTweaks.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoveN" Height="240" Width="340"
        WindowStyle="None" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
  <Grid RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <ScaleTransform x:Name="RootScale" ScaleX="0.7" ScaleY="0.7"/>
    </Grid.RenderTransform>

    <!-- Card background (same style as loading overlay) -->
    <Border CornerRadius="14" Background="#F2090909" BorderBrush="#28FFFFFF" BorderThickness="1">
      <Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.7"/>
      </Border.Effect>
    </Border>

    <StackPanel x:Name="SplashContent" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0">
      <StackPanel.RenderTransform>
        <TranslateTransform x:Name="SplashContentTranslate"/>
      </StackPanel.RenderTransform>

      <!-- Logo image -->
      <Image x:Name="SplashLogo" Source="pack://application:,,,/Assets/logo.png" Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
        <Image.RenderTransform>
          <TransformGroup>
            <ScaleTransform x:Name="SplashLogoScale"/>
            <RotateTransform x:Name="SplashLogoRotate"/>
          </TransformGroup>
        </Image.RenderTransform>
      </Image>

      <!-- Braille-dot spinner (same animation as loading overlay) -->
      <TextBlock x:Name="SpinnerLabel" Text="?" FontSize="34"
                 Foreground="#A0C8FF" HorizontalAlignment="Center"
                 FontFamily="Segoe UI" Margin="0,0,0,14"/>

      <!-- App name -->
      <TextBlock x:Name="AppLabel" Text="NoveN" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold"
                 Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>

      <!-- Subtitle -->
      <TextBlock x:Name="SubLabel" Text="Loading..." FontFamily="Segoe UI" FontSize="11"
                 Foreground="#60FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,0"/>

    </StackPanel>
  </Grid>
</Window>
