<Window x:Class="NoveNTweaks.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NoveN Tweaks v1.4"
    Height="900" Width="1420"
    MinHeight="660" MinWidth="1100"
    WindowStyle="None"
    AllowsTransparency="True"
    ResizeMode="CanResize"
    UseLayoutRounding="True"
    Background="Transparent"
    Foreground="{DynamicResource FgPrimary}"
    FontFamily="Segoe UI"
    WindowStartupLocation="CenterScreen"
    RenderOptions.ClearTypeHint="Enabled"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
  <Window.Resources>

    <!-- ===== APPLE TOGGLE - Black and White ===== -->
    <Style x:Key="ToggleStyle" TargetType="CheckBox">
      <Setter Property="Cursor"             Value="Hand"/>
      <Setter Property="VerticalAlignment"  Value="Center"/>
      <Setter Property="FocusVisualStyle"   Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="Track" Width="46" Height="26"
                    CornerRadius="13" BorderThickness="1"
                    BorderBrush="{DynamicResource TrackOffBorder}" Background="{DynamicResource TrackOffBg}">
              <Ellipse x:Name="Knob" Width="20" Height="20"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="3,0,0,0" Fill="{DynamicResource KnobFill}"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <TransformGroup>
                    <TranslateTransform x:Name="KnobSlide" X="0"/>
                    <ScaleTransform x:Name="KnobScale" ScaleX="1" ScaleY="1"/>
                  </TransformGroup>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
              <!-- Checked & Animations Enabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
              </MultiDataTrigger>

              <!-- Checked & Animations Disabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X" To="20" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X" To="0" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
              </MultiDataTrigger>

              <!-- MouseOver & Animations Enabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
              </MultiDataTrigger>

              <!-- MouseOver & Animations Disabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== APPLE TOGGLE FOR APP PICKER (With ContentPresenter) ===== -->
    <Style x:Key="AppPickerToggleStyle" TargetType="CheckBox">
      <Setter Property="Cursor"             Value="Hand"/>
      <Setter Property="VerticalAlignment"  Value="Center"/>
      <Setter Property="FocusVisualStyle"   Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <!-- Toggle switch track -->
              <Border x:Name="Track" Grid.Column="0" Width="42" Height="22"
                      CornerRadius="11" BorderThickness="1"
                      BorderBrush="{DynamicResource TrackOffBorder}" Background="{DynamicResource TrackOffBg}">
                <Ellipse x:Name="Knob" Width="16" Height="16"
                         HorizontalAlignment="Left" VerticalAlignment="Center"
                         Margin="2,0,0,0" Fill="{DynamicResource KnobFill}"
                         RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform>
                    <TransformGroup>
                      <TranslateTransform x:Name="KnobSlide" X="0"/>
                      <ScaleTransform x:Name="KnobScale" ScaleX="1" ScaleY="1"/>
                    </TransformGroup>
                  </Ellipse.RenderTransform>
                </Ellipse>
              </Border>
              <!-- Content Presenter on the right -->
              <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- Checked & Animations Enabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
              </MultiDataTrigger>

              <!-- Checked & Animations Disabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X" To="20" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobSlide" Storyboard.TargetProperty="X" To="0" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
              </MultiDataTrigger>

              <!-- MouseOver & Animations Enabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
              </MultiDataTrigger>

              <!-- MouseOver & Animations Disabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="KnobScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
              </MultiDataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== DASHBOARD HOVER ZOOM CARD ===== -->
    <Style x:Key="DashboardCardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceMid}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <!-- Animations Enabled -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
            <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
          </MultiDataTrigger.Conditions>
          <MultiDataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.012" Duration="0:0:0.22">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.012" Duration="0:0:0.22">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </MultiDataTrigger.EnterActions>
          <MultiDataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.22">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.22">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </MultiDataTrigger.ExitActions>
          <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        </MultiDataTrigger>

        <!-- Animations Disabled -->
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
            <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
          </MultiDataTrigger.Conditions>
          <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
        </MultiDataTrigger>
      </Style.Triggers>
    </Style>

    <!-- ===== SIDEBAR NAV ITEM ===== -->
    <Style x:Key="NavStyle" TargetType="RadioButton">
      <Setter Property="Cursor"           Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="GroupName"        Value="MainNav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Margin="6,2" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="NavScale" ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <Border x:Name="bgHover" CornerRadius="10" Background="{DynamicResource NavHoverBg}" Opacity="0" />
              <Border x:Name="bgChecked" CornerRadius="10" Opacity="0" Background="{DynamicResource NavCheckedBg}"/>
              <Grid Margin="0,10">
                <Rectangle x:Name="AccentBar" Width="3" VerticalAlignment="Center" Height="0"
                           HorizontalAlignment="Left" RadiusX="2" RadiusY="2"
                           Opacity="0" Fill="{DynamicResource Accent}"/>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
                  <TextBlock x:Name="Icon" Text="{TemplateBinding Tag}"
                             FontFamily="Segoe MDL2 Assets" FontSize="16"
                             Width="24" Foreground="{DynamicResource FgIcon}" VerticalAlignment="Center" TextAlignment="Center"/>
                  <TextBlock x:Name="Label" Text="{TemplateBinding Content}"
                             FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource FgIcon}" VerticalAlignment="Center"
                             Margin="12,0,0,0">
                    <TextBlock.RenderTransform>
                      <TranslateTransform x:Name="SPTrans" X="0"/>
                    </TextBlock.RenderTransform>
                     <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                          <!-- Sidebar Hover & Animations Enabled -->
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding ElementName=Sidebar, Path=IsMouseOver}" Value="True"/>
                              <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                              <BeginStoryboard>
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                  </DoubleAnimation>
                                </Storyboard>
                              </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                              <BeginStoryboard>
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                                </Storyboard>
                              </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                          </MultiDataTrigger>

                          <!-- Sidebar Hover & Animations Disabled -->
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding ElementName=Sidebar, Path=IsMouseOver}" Value="True"/>
                              <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1"/>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- Checked & Animations Enabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bgChecked" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Height" To="18" Duration="0:0:0.26">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="SPTrans" Storyboard.TargetProperty="X" To="6" Duration="0:0:0.3">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bgChecked" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Height" To="0" Duration="0:0:0.2" />
                      <DoubleAnimation Storyboard.TargetName="SPTrans" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
                <Setter TargetName="Icon"      Property="Foreground" Value="{DynamicResource FgPrimary}"/>
                <Setter TargetName="Label"     Property="Foreground" Value="{DynamicResource FgPrimary}"/>
              </MultiDataTrigger>

              <!-- Checked & Animations Disabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bgChecked" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Height" To="18" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="SPTrans" Storyboard.TargetProperty="X" To="6" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bgChecked" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="AccentBar" Storyboard.TargetProperty="Height" To="0" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="SPTrans" Storyboard.TargetProperty="X" To="0" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
                <Setter TargetName="Icon"      Property="Foreground" Value="{DynamicResource FgPrimary}"/>
                <Setter TargetName="Label"     Property="Foreground" Value="{DynamicResource FgPrimary}"/>
              </MultiDataTrigger>

              <!-- MouseOver & Animations Disabled -->
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding Path=AreAnimationsEnabled, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/>
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bgHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.EnterActions>
                <MultiDataTrigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bgHover" Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="NavScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiDataTrigger.ExitActions>
              </MultiDataTrigger>

              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True"/>
                  <Condition Property="IsChecked"   Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Icon"  Property="Foreground" Value="{DynamicResource FgHigh}"/>
                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource FgHigh}"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== TWEAK CARD  no per-card shadow (major perf gain with 50+ cards) ===== -->
