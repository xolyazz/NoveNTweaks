                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="15" Padding="{TemplateBinding Padding}"
                      Height="{TemplateBinding Height}">
                
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="bd" Property="Background"  Value="{DynamicResource GhostHoverBg}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource GhostHoverBorder}"/>
                <Setter Property="Foreground"                  Value="{DynamicResource GhostHoverFg}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.1"/>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.1"/>
                      <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.1"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.25"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== WINDOW CONTROL BUTTONS ===== -->
    <Style x:Key="WinBtn" TargetType="Button">
      <Setter Property="Width"            Value="42"/>
      <Setter Property="Height"           Value="32"/>
      <Setter Property="Background"       Value="Transparent"/>
      <Setter Property="Foreground"       Value="{DynamicResource FgFaint}"/>
      <Setter Property="BorderThickness"  Value="0"/>
      <Setter Property="FontSize"         Value="13"/>
      <Setter Property="Cursor"           Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource WinBtnHoverBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource WinBtnHoverFg}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WinBtnClose" TargetType="Button">
      <Setter Property="Width"            Value="42"/>
      <Setter Property="Height"           Value="32"/>
      <Setter Property="Background"       Value="Transparent"/>
      <Setter Property="Foreground"       Value="{DynamicResource FgFaint}"/>
      <Setter Property="BorderThickness"  Value="0"/>
      <Setter Property="FontSize"         Value="11"/>
      <Setter Property="Cursor"           Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#CC500000"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#CC800000"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ===== SLIM FROSTED SCROLLBAR ===== -->
    <Style x:Key="DarkThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="bd" CornerRadius="7" Margin="2,1" Background="{DynamicResource ThumbBg}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ThumbHoverBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkRepeatBtn" TargetType="RepeatButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Width"       Value="16"/>
      <Setter Property="MinWidth"    Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{DynamicResource TrackLane}" CornerRadius="6" Margin="0,4">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource DarkRepeatBtn}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource DarkThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource DarkRepeatBtn}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <!-- ===== ROOT: liquid glass window ===== -->
  <Border x:Name="RootBorder" CornerRadius="16" Margin="0" ClipToBounds="True" SnapsToDevicePixels="True"
          Background="{DynamicResource RootBg}"
          RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform>
      <ScaleTransform x:Name="RootBorderScale" ScaleX="1" ScaleY="1"/>
    </Border.RenderTransform>

    <Grid>
      <!-- ===== Task 4: CUSTOM BACKGROUND (image or video) ===== -->
      <!-- Both Image and MediaElement are Collapsed by default. Apply-CustomBackground -->
      <!-- makes the right one Visible based on file type. -->
      <Grid Panel.ZIndex="-10" IsHitTestVisible="False">
        <Grid.OpacityMask>
          <VisualBrush Stretch="Fill">
            <VisualBrush.Visual>
              <Border Background="White" CornerRadius="16"
                      Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}"
                      Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}"/>
            </VisualBrush.Visual>
          </VisualBrush>
        </Grid.OpacityMask>
        <Image x:Name="BgImage" Stretch="UniformToFill" Visibility="Collapsed"/>
        <MediaElement x:Name="BgVideo" Stretch="UniformToFill" Visibility="Collapsed"
                      IsMuted="True" LoadedBehavior="Manual" UnloadedBehavior="Stop"/>
        <!-- Veil over the custom background so text stays readable (theme-aware) -->
        <Border x:Name="BgOverlay" Visibility="Collapsed" Opacity="0.72" Background="{DynamicResource BgVeil}"/>
      </Grid>

      <!-- ===== ANIMATED BACKGROUND ORBS ===== -->
      <Canvas x:Name="OrbCanvas" IsHitTestVisible="False" ClipToBounds="True">
        <!-- Orb 1  large, top-left -->
        <Ellipse x:Name="Orb1" Canvas.Left="60" Canvas.Top="80"
                 Width="480" Height="480" Opacity="0.045">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="White" Offset="0"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform>
            <TranslateTransform x:Name="Orb1T" X="0" Y="0"/>
          </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Orb 2  medium, right — v2.8: more visible -->
        <Ellipse x:Name="Orb2" Canvas.Left="650" Canvas.Top="180"
                 Width="340" Height="340" Opacity="0.09">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#5B9CE8" Offset="0"/>
              <GradientStop Color="#1A3A5F" Offset="0.5"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform>
            <TranslateTransform x:Name="Orb2T" X="0" Y="0"/>
          </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Orb 3  small, bottom-center -->
        <Ellipse x:Name="Orb3" Canvas.Left="380" Canvas.Top="500"
                 Width="260" Height="260" Opacity="0.04">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="White" Offset="0"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform>
            <TranslateTransform x:Name="Orb3T" X="0" Y="0"/>
          </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Orb 4  tiny accent, bottom-right -->
        <Ellipse x:Name="Orb4" Canvas.Left="850" Canvas.Top="550"
                 Width="180" Height="180" Opacity="0.03">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="White" Offset="0"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform>
            <TranslateTransform x:Name="Orb4T" X="0" Y="0"/>
          </Ellipse.RenderTransform>
        </Ellipse>
      </Canvas>

      <!-- ===== SUBTLE VIGNETTE  lightweight gradient, no BlurEffect ===== -->
      <Border IsHitTestVisible="False" CornerRadius="16">
        <Border.Background>
          <RadialGradientBrush Center="0.35,0.25" RadiusX="1.0" RadiusY="1.0">
            <GradientStop Color="#0FFFFFFF" Offset="0"/>
            <GradientStop Color="#04FFFFFF" Offset="0.6"/>
            <GradientStop Color="#08FFFFFF" Offset="1"/>
          </RadialGradientBrush>
        </Border.Background>
      </Border>

      <!-- ===== TOP SHIMMER LINE (liquid glass highlight) ===== -->
      <Border Height="1.5" VerticalAlignment="Top" HorizontalAlignment="Stretch"
              Margin="24,0" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="Transparent"  Offset="0"/>
            <GradientStop Color="#30FFFFFF"    Offset="0.15"/>
            <GradientStop Color="#70FFFFFF"    Offset="0.4"/>
            <GradientStop Color="#90FFFFFF"    Offset="0.5"/>
            <GradientStop Color="#70FFFFFF"    Offset="0.6"/>
            <GradientStop Color="#30FFFFFF"    Offset="0.85"/>
            <GradientStop Color="Transparent"  Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <!-- Inner glass border glow -->
      <Border CornerRadius="16" BorderThickness="1" IsHitTestVisible="False">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#35FFFFFF" Offset="0"/>
            <GradientStop Color="#12FFFFFF" Offset="0.4"/>
            <GradientStop Color="#08FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
      </Border>

      <!-- Main layout grid -->
      <Grid x:Name="MainGrid">
        <Grid.RowDefinitions>
          <RowDefinition Height="48"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="56"/>
        </Grid.RowDefinitions>

        <!-- ===== TITLE BAR ===== -->
        <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{DynamicResource SurfaceLow}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" CornerRadius="16,16,0,0">
          <Border.RenderTransform>
            <TranslateTransform x:Name="TitleBarTranslate"/>
          </Border.RenderTransform>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- v2.5: Animated progress bar overlay at bottom of title bar (bigger, cleaner) -->
            <ProgressBar x:Name="TopProgressBar" Grid.ColumnSpan="3" VerticalAlignment="Bottom" Height="4" Minimum="0" Maximum="100" Value="0"
                         IsIndeterminate="False" Visibility="Collapsed" Panel.ZIndex="50"
                         Background="Transparent" BorderThickness="0" ClipToBounds="True">
              <ProgressBar.Foreground>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#3B82F6" Offset="0"/>
                  <GradientStop Color="#60A5FA" Offset="0.5"/>
                  <GradientStop Color="#3B82F6" Offset="1"/>
                </LinearGradientBrush>
              </ProgressBar.Foreground>
              <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar">
                  <Grid>
                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="0"/>
                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="0"/>
                  </Grid>
                </ControlTemplate>
              </ProgressBar.Template>
            </ProgressBar>
            <Border x:Name="TopProgressLabelWrap" Grid.ColumnSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                    Visibility="Collapsed" Panel.ZIndex="51" Background="#0F172A" CornerRadius="6" Padding="10,4" BorderBrush="#1E3A5F" BorderThickness="1">
              <TextBlock x:Name="TopProgressLabel" FontSize="11" Foreground="#60A5FA" FontFamily="Consolas" FontWeight="SemiBold"/>
            </Border>

            <!-- Logo + Name -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
              <Border x:Name="DragHandle" Background="Transparent" Width="0" Height="48"/>
              <Border CornerRadius="8" Width="28" Height="28" ClipToBounds="True">
                <Rectangle x:Name="TitleBarLogo" Width="28" Height="28" Fill="{DynamicResource FgPrimary}" Cursor="Hand">
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="UniformToFill"/>
                    </Rectangle.OpacityMask>
                    <Rectangle.RenderTransform>
                        <RotateTransform x:Name="TitleBarLogoRotate" CenterX="14" CenterY="14" Angle="0"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
              </Border>
              <TextBlock Text="NoveN Tweaks" FontSize="13" FontWeight="SemiBold"
                         Foreground="{DynamicResource FgHigh}" VerticalAlignment="Center" Margin="8,0,0,0"/>
              <Border Background="{DynamicResource SurfaceMid}" CornerRadius="5" Padding="5,2" Margin="6,0,0,0"
                      BorderBrush="{DynamicResource BorderMid}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock Text="v1.4" FontSize="9" FontFamily="Consolas" Foreground="{DynamicResource FgMid}"/>
              </Border>
            </StackPanel>

            <!-- Title bar drag area -->
            <Border x:Name="TitleBarDrag" Grid.Column="1" Background="Transparent"/>

            <!-- Status label (hidden) -->
            <TextBlock x:Name="StatusLabel" Grid.Column="1" FontSize="11"
                       FontFamily="Consolas" Foreground="{DynamicResource FgFaint}"
                       VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed"/>

            <!-- Window controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
              <Button x:Name="BtnLang" Click="OnBtnLangClick" Style="{StaticResource WinBtn}" FontFamily="Segoe UI" FontSize="11" Width="58" ToolTip="Select language"/>
              <Button x:Name="BtnMin"   Style="{StaticResource WinBtn}" Content="&#8722;" FontSize="16"/>
              <Button x:Name="BtnMax"   Style="{StaticResource WinBtn}" Content="&#9633;" FontSize="12"/>
              <Button x:Name="BtnClose" Style="{StaticResource WinBtnClose}" Content="&#10005;" FontSize="11"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- ===== MAIN CONTENT ===== -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- ===== SIDEBAR ===== -->
          <Border x:Name="Sidebar" Width="64" ClipToBounds="True" Grid.Column="0" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,1,0">
            <Border.RenderTransform>
              <TranslateTransform x:Name="SidebarTranslate"/>
            </Border.RenderTransform>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#08FFFFFF" Offset="0"/>
                <GradientStop Color="#04FFFFFF" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <!-- Seamless diagonal dot texture (147 tile = 45 diagonal) -->
              <Rectangle IsHitTestVisible="False" Opacity="0.045">
                <Rectangle.Fill>
                  <DrawingBrush TileMode="Tile"
                                Viewport="0,0,14,7" ViewportUnits="Absolute"
                                Viewbox="0,0,14,7"  ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                      <DrawingGroup>
                        <GeometryDrawing Brush="White">
                          <GeometryDrawing.Geometry>
                            <GeometryGroup>
                              <EllipseGeometry Center="2.5,1.75" RadiusX="1" RadiusY="1"/>
                              <EllipseGeometry Center="9.5,5.25" RadiusX="1" RadiusY="1"/>
                            </GeometryGroup>
                          </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                      </DrawingGroup>
                    </DrawingBrush.Drawing>
                  </DrawingBrush>
                </Rectangle.Fill>
              </Rectangle>
              <DockPanel>

              
              <RadioButton x:Name="RBContextMenu" DockPanel.Dock="Bottom" Tag="&#xE8AB;" Content="Context Menu" Style="{StaticResource NavStyle}" GroupName="MainNav"/>
              <RadioButton x:Name="RBSettings" DockPanel.Dock="Bottom" Tag="&#xE713;" Content="Settings" Style="{StaticResource NavStyle}" Margin="0,0,0,10"/>

              <StackPanel Margin="0,10,0,0">
                <!-- Home -->
                <RadioButton x:Name="RBHome" Tag="&#xE80F;" Content="Home"
                             Style="{StaticResource NavStyle}" IsChecked="True"/>

                <!-- Divider -->
                <Rectangle Height="1" Margin="16,8">
                  <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <GradientStop Color="Transparent" Offset="0"/>
                      <GradientStop Color="#18FFFFFF"   Offset="0.5"/>
                      <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>

                <RadioButton x:Name="RBPrivacy"  Tag="&#xE72E;" Content="Privacy"      Style="{StaticResource NavStyle}"/>
                <RadioButton x:Name="RBPerf"     Tag="&#xE9D9;" Content="Performance"  Style="{StaticResource NavStyle}"/>
                <RadioButton x:Name="RBDebloat"  Tag="&#xE74D;" Content="Debloat"      Style="{StaticResource NavStyle}"/>
                <RadioButton x:Name="RBUpdates"  Tag="&#xE72C;" Content="Updates"      Style="{StaticResource NavStyle}"/>
                <RadioButton x:Name="RBNetwork"  Tag="&#xF0B2;" Content="Network"      Style="{StaticResource NavStyle}"/>
                <RadioButton x:Name="RBInternet" Tag="&#xE909;" Content="Internet"     Style="{StaticResource NavStyle}"/>

                <RadioButton x:Name="RBSystem"   Tag="&#xE713;" Content="System"       Style="{StaticResource NavStyle}"/>
                <RadioButton x:Name="RBSecurity" Tag="&#xE8B3;" Content="Security"     Style="{StaticResource NavStyle}"/>
                <RadioButton x:Name="RBUI"       Tag="&#xE7F4;" Content="Interface / UI" Style="{StaticResource NavStyle}"/>
                <RadioButton x:Name="RBAppearance" Tag="&#xE771;" Content="Appearance" Style="{StaticResource NavStyle}"/>
                                <RadioButton x:Name="RBInstaller" Tag="&#xE896;" Content="Installer" Style="{StaticResource NavStyle}"/>
                <RadioButton x:Name="RBAdvanced" Tag="&#xE7BA;" Content="Advanced (DANGER)" Foreground="#EF4444" Style="{StaticResource NavStyle}"/>
              </StackPanel>
            </DockPanel>
            </Grid>
          </Border>

          <!-- ===== RIGHT PANEL ===== -->
          <Grid x:Name="RightPanelGrid" Grid.Column="1">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="RightPanelTranslate"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
              <RowDefinition Height="54"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page header -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceLow}"
                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
              <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="PageTitle" FontSize="18" FontWeight="Bold"
                             Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                  <Border x:Name="TweakCountBadge" Background="{DynamicResource SurfaceHigh}" CornerRadius="6"
                          Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center"
                          BorderBrush="{DynamicResource BorderMid}" BorderThickness="1">
                    <TextBlock x:Name="TweakCount" FontSize="10"
                               FontFamily="Consolas" Foreground="{DynamicResource FgMid}"/>
                  </Border>

                  <!-- Tweak Tracking: applied / total progress indicator (per category) -->
                  <Border x:Name="TweakProgressBadge" Background="{DynamicResource SurfaceMid}" CornerRadius="8"
                          Padding="10,4" Margin="8,0,0,0" VerticalAlignment="Center"
                          BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TweakProgressText" FontSize="10" FontFamily="Consolas"
                                 Foreground="{DynamicResource FgHigh}" VerticalAlignment="Center"/>
                      <!-- mini progress bar -->
                      <Border Width="64" Height="5" CornerRadius="3" Margin="8,0,0,0"
                              Background="{DynamicResource TrackLane}" VerticalAlignment="Center">
                        <Border x:Name="TweakProgressFill" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                          <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                              <GradientStop Color="#34D399" Offset="0"/>
                              <GradientStop Color="#10B981" Offset="1"/>
                            </LinearGradientBrush>
                          </Border.Background>
                        </Border>
                      </Border>
                    </StackPanel>
                  </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button x:Name="BtnSearchToggle" Style="{StaticResource BtnSec}"
                          Padding="10,5" Margin="0,0,8,0" ToolTip="Search tweaks (Ctrl+F)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                 VerticalAlignment="Center"/>
                      <TextBlock x:Name="TxtSearchToggleLabel" Text=" Search" FontSize="11" VerticalAlignment="Center"
                                 Margin="5,0,0,0"/>
                    </StackPanel>
                  </Button>
                  <Button x:Name="BtnSelectAll"   Style="{StaticResource BtnSec}" Margin="0,0,6,0"/>
                  <Button x:Name="BtnDeselectAll" Style="{StaticResource BtnSec}"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- ===== SEARCH OVERLAY ===== -->
            <Border x:Name="SearchPanel" Grid.Row="1" Panel.ZIndex="20"
                    VerticalAlignment="Top" Height="0" ClipToBounds="True"
                    CornerRadius="0,0,16,16" Visibility="Collapsed"
                    Background="{DynamicResource OverlayBg}">
              <Border BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1" CornerRadius="0,0,16,16">
                <Grid Margin="16,14,16,16">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <!-- Search input box -->
                  <Border Grid.Row="0" CornerRadius="12"
                          BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                    <Border.Background>
                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#22FFFFFF" Offset="0"/>
                        <GradientStop Color="#14FFFFFF" Offset="1"/>
                      </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                 FontSize="14" Foreground="{DynamicResource FgMuted}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 IsHitTestVisible="False"/>
                      <TextBox x:Name="SearchBox" Grid.Column="1"
                               Background="Transparent" BorderThickness="0"
                               Foreground="{DynamicResource FgPrimary}" CaretBrush="{DynamicResource FgPrimary}"
                               SelectionBrush="{DynamicResource AccentSoft}"
                               FontSize="13" VerticalAlignment="Center"
                               FocusVisualStyle="{x:Null}"
                               Tag="Search tweaks by name or category"/>
                      <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="Search tweaks by name or category"
                                 FontSize="13" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center"
                                 IsHitTestVisible="False">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <!-- Clear/Close button  no triggers in template, hover handled in PS -->
                      <Button x:Name="BtnSearchClear" Grid.Column="2"
                              Width="28" Height="28"
                              FontFamily="Segoe MDL2 Assets" FontSize="11"
                              Background="Transparent"
                              Foreground="{DynamicResource FgMuted}" Cursor="Hand"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              FocusVisualStyle="{x:Null}">
                        <Button.Template>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="14"
                                    Background="{TemplateBinding Background}"
                                    Width="28" Height="28">
                              <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                         FontSize="11" Foreground="{TemplateBinding Foreground}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </ControlTemplate>
                        </Button.Template>
                      </Button>
                    </Grid>
                  </Border>
                  <!-- Results area (virtualized: only visible rows are built/rendered, eliminating lag when 240+ tweaks are loaded) -->
                  <ItemsControl x:Name="SearchResults" Grid.Row="1" Margin="0,10,0,0" MaxHeight="260"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.PanningMode="VerticalOnly"
                                VirtualizingStackPanel.IsVirtualizing="True"
                                VirtualizingStackPanel.VirtualizationMode="Recycling"
                                VirtualizingStackPanel.ScrollUnit="Pixel">
                    <ItemsControl.Template>
                      <ControlTemplate TargetType="ItemsControl">
                        <Border>
                          <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                            <ItemsPresenter/>
                          </ScrollViewer>
                        </Border>
                      </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                  </ItemsControl>
                </Grid>
              </Border>
            </Border>

            <!-- ===== HOME PANEL ===== -->
            <ScrollViewer x:Name="PanelHome" Grid.Row="1"
                          VerticalScrollBarVisibility="Auto" Padding="20,18,20,18">
              <StackPanel>

                <!-- Hero card -->
                <Border CornerRadius="18" BorderBrush="{DynamicResource BorderMid}" BorderThickness="1"
                        Padding="32,28" Margin="0,0,0,20" Background="{DynamicResource SurfaceGlass}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Rectangle x:Name="HomeHeroLogo" Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,12,0" Fill="{DynamicResource FgPrimary}" Cursor="Hand">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://application:,,,/Assets/logo.png" Stretch="Uniform"/>
                            </Rectangle.OpacityMask>
                            <Rectangle.RenderTransform>
                                <RotateTransform x:Name="HomeHeroLogoRotate" CenterX="19" CenterY="19" Angle="0"/>
                            </Rectangle.RenderTransform>
                        </Rectangle>
                        <TextBlock Text="NoveN Tweaks" FontSize="34" FontWeight="Black"
                                   Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                      </StackPanel>
                      <TextBlock x:Name="TxtHomeSubtitle" Text="Windows optimization, redesigned."
                                 FontSize="14" Foreground="{DynamicResource FgMuted}" Margin="0,0,0,10"/>
                      <!-- Subtle accent gradient line -->
                      <Rectangle Width="220" Height="2" HorizontalAlignment="Left" Margin="0,0,0,0" RadiusX="1" RadiusY="1">
                        <Rectangle.Fill>
                          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="{DynamicResource AccentColor}" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                          </LinearGradientBrush>
                        </Rectangle.Fill>
                      </Rectangle>

                      <!-- Stat pills -->
                      <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Border x:Name="HomePillTotal" Style="{StaticResource DashboardCardStyle}"
                                Padding="16,10" Margin="0,0,8,0">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE912;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock x:Name="HomeTotalCount" Text="..." FontSize="18"
                                         FontWeight="Bold" Foreground="{DynamicResource FgPrimary}"/>
                              <TextBlock x:Name="TxtHomeTotalTweaks" Text="Total Tweaks" FontSize="9.5" Foreground="{DynamicResource FgMuted}"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}"
                                Padding="16,10" Margin="0,0,8,0">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#818CF8" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock x:Name="HomeCatCount" Text="9" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}"/>
                              <TextBlock x:Name="TxtHomeCategories" Text="Categories" FontSize="9.5" Foreground="{DynamicResource FgMuted}"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <Border Style="{StaticResource DashboardCardStyle}"
                                Padding="16,10">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="v1.4" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}"/>
                              <TextBlock x:Name="TxtHomeVersion" Text="Version" FontSize="9.5" Foreground="{DynamicResource FgMuted}"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>

                <!-- ===== COMPACT SYSTEM INFO (4-column, minimalist) ===== -->
                 <Border CornerRadius="16" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="16" Margin="0,0,0,16" Background="{DynamicResource SurfaceGlass}">
                  <StackPanel>
                    <TextBlock x:Name="TxtHomeSysInfoTitle" Text="System Information" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" Margin="0,0,0,10"/>

                    <UniformGrid Columns="4" Margin="0,0,0,0">
                      <!-- CPU (compact) -->
                      <Border Style="{StaticResource DashboardCardStyle}" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <!-- Text on left -->
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                              <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="{DynamicResource AccentFg}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                              <TextBlock x:Name="TxtHomeCpuLabel" Text="CPU" Foreground="{DynamicResource FgMuted}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="StatCpuName" Text="Detecting..." Foreground="{DynamicResource FgPrimary}" FontSize="9" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <!-- Circular Gauge on right -->
                          <Grid Grid.Column="1" Width="36" Height="36" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Stroke="{DynamicResource BorderSoft}" StrokeThickness="3"/>
                            <Path Stroke="#34D399" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                              <Path.Data>
                                <PathGeometry>
                                  <PathFigure x:Name="CpuArcFigure" StartPoint="18,1.5">
                                    <ArcSegment x:Name="CpuArcSegment" Size="16.5,16.5" SweepDirection="Clockwise" IsLargeArc="False"/>
                                  </PathFigure>
                                </PathGeometry>
                              </Path.Data>
                            </Path>
                            <TextBlock x:Name="StatCpuUsage" Text="--%" FontSize="9" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          </Grid>
                        </Grid>
                      </Border>

                      <!-- RAM (compact) -->
                      <Border Style="{StaticResource DashboardCardStyle}" CornerRadius="8" Padding="10,8" Margin="6,0,6,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <!-- Text on left -->
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                              <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#A78BFA" VerticalAlignment="Center" Margin="0,0,4,0"/>
                              <TextBlock x:Name="TxtHomeRamLabel" Text="MEMORY" Foreground="{DynamicResource FgMuted}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="StatRamInfo" Text="Detecting..." Foreground="{DynamicResource FgPrimary}" FontSize="9" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <!-- Circular Gauge on right -->
                          <Grid Grid.Column="1" Width="36" Height="36" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Stroke="{DynamicResource BorderSoft}" StrokeThickness="3"/>
                            <Path Stroke="#FBBF24" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                              <Path.Data>
                                <PathGeometry>
                                  <PathFigure x:Name="RamArcFigure" StartPoint="18,1.5">
                                    <ArcSegment x:Name="RamArcSegment" Size="16.5,16.5" SweepDirection="Clockwise" IsLargeArc="False"/>
                                  </PathFigure>
                                </PathGeometry>
                              </Path.Data>
                            </Path>
                            <TextBlock x:Name="StatRamUsage" Text="--%" FontSize="9" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          </Grid>
                        </Grid>
                      </Border>

                      <!-- OS (compact) -->
                      <Border Style="{StaticResource DashboardCardStyle}" CornerRadius="8" Padding="10,8" Margin="6,0,6,0">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <!-- Text on left -->
                          <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                              <TextBlock Text="&#xE7F7;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#34D399" VerticalAlignment="Center" Margin="0,0,4,0"/>
                              <TextBlock x:Name="TxtHomeSysLabel" Text="SYSTEM" Foreground="{DynamicResource FgMuted}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="StatOsName" Text="Detecting..." Foreground="{DynamicResource FgPrimary}" FontSize="9" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="StatOsUptime" Text="" Foreground="{DynamicResource FgMuted}" FontSize="8" Margin="0,2,0,0"/>
                          </StackPanel>
                          <!-- Icon on right -->
                          <Grid Grid.Column="1" Width="36" Height="36" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Ellipse Stroke="{DynamicResource BorderSoft}" StrokeThickness="1"/>
                            <TextBlock Text="&#xE7F7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#60A5FA" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          </Grid>
                        </Grid>
                      </Border>

                      <!-- GPU (compact) -->
                      <Border Style="{StaticResource DashboardCardStyle}" CornerRadius="8" Padding="10,8" Margin="6,0,0,0">
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>
                          
                          <!-- GPU 1 -->
                          <Grid Grid.Row="0" x:Name="Gpu1Section">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Text on left -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#F87171" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="TxtHomeGpuLabel" Text="GPU" Foreground="{DynamicResource FgMuted}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                              </StackPanel>
                              <TextBlock x:Name="StatGpuName" Text="Detecting..." Foreground="{DynamicResource FgPrimary}" FontSize="9" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                              <TextBlock x:Name="StatGpuVRAM" Text="" Foreground="{DynamicResource FgMuted}" FontSize="8" Margin="0,1,0,0"/>
                            </StackPanel>
                            <!-- Circular Gauge on right -->
                            <Grid Grid.Column="1" Width="36" Height="36" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                              <Ellipse Stroke="{DynamicResource BorderSoft}" StrokeThickness="3"/>
                              <Path Stroke="#F87171" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                <Path.Data>
                                  <PathGeometry>
                                    <PathFigure x:Name="GpuArcFigure" StartPoint="18,1.5">
                                      <ArcSegment x:Name="GpuArcSegment" Size="16.5,16.5" SweepDirection="Clockwise" IsLargeArc="False"/>
                                    </PathFigure>
                                  </PathGeometry>
                                </Path.Data>
                              </Path>
                              <TextBlock x:Name="StatGpuUsage" Text="--%" FontSize="9" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                          </Grid>
                          
                          <!-- GPU 2 -->
                          <Grid Grid.Row="1" x:Name="Gpu2Section" Visibility="Collapsed" Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Margin="0,0,0,6"/>
                            <Grid Grid.Row="1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <!-- Text on left -->
                              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                  <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#F87171" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                  <TextBlock x:Name="TxtHomeGpu2Label" Text="GPU 2" Foreground="{DynamicResource FgMuted}" FontSize="8" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="StatGpu2Name" Text="Detecting..." Foreground="{DynamicResource FgPrimary}" FontSize="9" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="StatGpu2VRAM" Text="" Foreground="{DynamicResource FgMuted}" FontSize="8" Margin="0,1,0,0"/>
                              </StackPanel>
                              <!-- Circular Gauge on right -->
                              <Grid Grid.Column="1" Width="36" Height="36" Margin="8,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Ellipse Stroke="{DynamicResource BorderSoft}" StrokeThickness="3"/>
                                <Path Stroke="#F87171" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                  <Path.Data>
                                    <PathGeometry>
                                      <PathFigure x:Name="Gpu2ArcFigure" StartPoint="18,1.5">
                                        <ArcSegment x:Name="Gpu2ArcSegment" Size="16.5,16.5" SweepDirection="Clockwise" IsLargeArc="False"/>
                                      </PathFigure>
                                    </PathGeometry>
                                  </Path.Data>
                                </Path>
                                <TextBlock x:Name="StatGpu2Usage" Text="--%" FontSize="9" FontFamily="Segoe UI" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                              </Grid>
                            </Grid>
                          </Grid>
                        </Grid>
                      </Border>
                    </UniformGrid>

                    <UniformGrid x:Name="StatExtraGpuGrid" Columns="2" Margin="0,6,0,0"/>
                  </StackPanel>
                </Border>

                <!-- ===== LIVE TELEMETRY (improved: large %, clear toggles, smooth graph) ===== -->
                <!-- v2.6: No DashboardCardStyle (no hover scale — chart is too large to scale).
                     No DropShadowEffect (removes the blur the user complained about). -->
                <Border CornerRadius="16" Background="{DynamicResource SurfaceGlass}"
                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                        Padding="20" Margin="0,0,0,16">
                  <StackPanel>
                    <!-- Header: title on left, toggle buttons on right -->
                    <Grid Margin="0,0,0,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- Left: title and collapsed percentage value -->
                      <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHomeTelemetryTitle" Text="Live Telemetry" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TelemetryCurrentVal" Text="--%" FontSize="36" FontWeight="Black"
                                   Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center" Margin="16,0,0,0"
                                   FontFamily="Consolas" Visibility="Collapsed"/>
                      </StackPanel>
                      <!-- Right: Clear toggle buttons CPU / GPU / RAM (unified capsule) -->
                      <Border Grid.Column="1" CornerRadius="8" Background="{DynamicResource SurfaceMid}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" x:Name="TelemetryTogglePanel">
                          <Border x:Name="TelemetryBtnCPU" CornerRadius="6" Padding="14,6" Margin="0,0,2,0"
                                  Background="Transparent" Cursor="Hand" MouseLeftButtonDown="TelemetryToggle_Click" Tag="CPU">
                            <TextBlock x:Name="TxtTelemetryCPU" Text="CPU" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                          </Border>
                          <Border x:Name="TelemetryBtnGPU" CornerRadius="6" Padding="14,6" Margin="0,0,2,0"
                                  Background="Transparent" Cursor="Hand" MouseLeftButtonDown="TelemetryToggle_Click" Tag="GPU">
                            <TextBlock x:Name="TxtTelemetryGPU" Text="GPU" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource FgMid}" VerticalAlignment="Center"/>
                          </Border>
                          <Border x:Name="TelemetryBtnRAM" CornerRadius="6" Padding="14,6"
                                  Background="Transparent" Cursor="Hand" MouseLeftButtonDown="TelemetryToggle_Click" Tag="RAM">
                            <TextBlock x:Name="TxtTelemetryRAM" Text="RAM" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource FgMid}" VerticalAlignment="Center"/>
                          </Border>
                        </StackPanel>
                      </Border>
                    </Grid>

                    <!-- Graph Grid containing Y-axis labels, Chart and X-axis labels -->
                    <Grid Margin="0,16,0,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="180"/> <!-- The chart area -->
                        <RowDefinition Height="Auto"/> <!-- The X-axis labels -->
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/> <!-- Y-axis labels -->
                        <ColumnDefinition Width="*"/>  <!-- Chart lines and grid lines -->
                      </Grid.ColumnDefinitions>

                      <!-- Y-Axis Labels (Column 0, Row 0) -->
                      <!-- Aligned with grid lines at 100%, 80%, 60%, 40%, 20%, 0% -->
                      <Grid Grid.Column="0" Grid.Row="0" Margin="0,0,8,0" IsHitTestVisible="False">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="*"/>
                          <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="100%" Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI" Margin="0,-6,0,0"/>
                        <TextBlock Text="80%" Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI" Margin="0,0,0,-6"/>
                        <TextBlock Text="60%" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI" Margin="0,0,0,-6"/>
                        <TextBlock Text="40%" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI" Margin="0,0,0,-6"/>
                        <TextBlock Text="20%" Grid.Row="3" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI" Margin="0,0,0,-6"/>
                        <TextBlock Text="0" Grid.Row="4" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI" Margin="0,0,0,-6"/>
                      </Grid>

                      <!-- Chart Area (Column 1, Row 0) -->
                      <Border Grid.Column="1" Grid.Row="0" CornerRadius="10" Background="{DynamicResource SurfaceLow}"
                              BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                          <!-- Grid lines -->
                          <Canvas x:Name="TelemetryGridCanvas" IsHitTestVisible="False"/>
                          <!-- v2.8: Clean chart — no glow, no DropShadow, simple dot -->
                          <Canvas x:Name="TelemetryCanvas" IsHitTestVisible="False" ClipToBounds="True">
                            <Polyline x:Name="TelemetryArea" StrokeThickness="0"/>
                            <Polyline x:Name="TelemetryLine" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <!-- Simple endpoint dot (no halo glow) -->
                            <Ellipse x:Name="TelemetryGlowCore" Width="6" Height="6" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <!-- Halo kept for code compat but made tiny and subtle -->
                            <Ellipse x:Name="TelemetryGlowHalo" Width="10" Height="10" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.3"/>
                          </Canvas>
                        </Grid>
                      </Border>

                      <!-- X-Axis Labels (Column 1, Grid.Row 1) -->
                      <!-- Aligned at 0%, 25%, 50%, 75%, 100% of the chart area -->
                      <Grid Grid.Column="1" Grid.Row="1" Margin="0,8,0,0" IsHitTestVisible="False">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="60 seconds" Grid.Column="0" HorizontalAlignment="Left" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI"/>
                        <TextBlock Text="45 seconds" Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,-26,0" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI"/>
                        <TextBlock Text="30 seconds" Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,-26,0" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI"/>
                        <TextBlock Text="15 seconds" Grid.Column="2" HorizontalAlignment="Right" Margin="0,0,-26,0" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI"/>
                        <TextBlock Text="0 seconds" Grid.Column="3" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource FgFaint}" FontFamily="Segoe UI"/>
                      </Grid>
                    </Grid>
                  </StackPanel>
                </Border>

                <!-- Category grid (kept hidden — categories live in the sidebar) -->
                <TextBlock x:Name="TxtHomeCatsHeader" Text="CATEGORIES" FontSize="9" FontWeight="SemiBold"
                           Foreground="{DynamicResource FgFaint}" Margin="2,0,0,10" Visibility="Collapsed"/>
                <UniformGrid x:Name="HomeCategoryGrid" Columns="4" Visibility="Collapsed"/>

                <!-- Creator section removed (no creator mentions/links) -->
                <TextBlock x:Name="TxtHomeCreatorHeader" Text="" Visibility="Collapsed"/>
                <Border x:Name="HomeYouTube" Visibility="Collapsed"/>
                <Border x:Name="HomeWebsite" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtHomeYouTube" Text="" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtHomeWebsite" Text="" Visibility="Collapsed"/>

                <!-- ===== FOOTER: stylish modern thank-you box ===== -->
                <Border CornerRadius="12" Margin="40,20,40,8" Padding="20,14"
                        Background="{DynamicResource SurfaceGlass}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                  <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#000000" Opacity="0.10"/>
                  </Border.Effect>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🤍" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtThankYouFooter" Text="Thank you for using NoveN Tweaks"
                               FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgMid}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>

            <!-- ===== CATEGORY PANELS ===== -->
            <ScrollViewer x:Name="PanelPrivacy"  Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelPerf"     Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelDebloat"  Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelUpdates"  Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelNetwork"  Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelInternet" Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>

            <ScrollViewer x:Name="PanelSystem"   Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelSecurity" Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelUI"       Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelContextMenu" Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelAppearance" Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelInstaller" Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelAdvanced" Grid.Row="1" Padding="8,6,8,6"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PanelSettings" Grid.Row="1" Padding="20,18,20,18"
                          VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel>
                <!-- Theme Card -->


                <Border CornerRadius="18" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="24" Margin="0,0,0,20" Background="{DynamicResource SurfaceGlass}">
                  <StackPanel>
                     <TextBlock x:Name="TxtSettingTheme" Text="Theme" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtSettingThemeSub" Text="Application Theme" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSettingThemeDesc" Text="Choose the visual theme. Dark = pure dark background, Normal = default dark with subtle transparency and ambient orbs." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    
                    <!-- 2 clickable theme cards (Light removed) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                      <Border x:Name="ThemeDark" CornerRadius="10" Width="120" Margin="0,0,10,0" Padding="14" Cursor="Hand" BorderBrush="{DynamicResource BorderMid}" BorderThickness="1" Background="{DynamicResource SurfaceMid}">
                        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/></Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                          <Border Width="40" Height="40" CornerRadius="8" Background="#FF0E0E0E" Margin="0,0,0,8">
                            <Border Width="20" Height="20" CornerRadius="4" Background="#FF333333" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock x:Name="TxtThemeDarkLabel" Text="Dark" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                      <Border x:Name="ThemeNormal" CornerRadius="10" Width="120" Padding="14" Cursor="Hand" BorderBrush="{DynamicResource BorderMid}" BorderThickness="1" Background="{DynamicResource SurfaceMid}">
                        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/></Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                          <Border Width="40" Height="40" CornerRadius="8" Background="#FF0D0D10" Margin="0,0,0,8">
                            <Border Width="20" Height="20" CornerRadius="4" Background="#FF222238" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock x:Name="TxtThemeNormalLabel" Text="Normal" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                      <Border x:Name="ThemeWhite" CornerRadius="10" Width="120" Padding="14" Cursor="Hand" BorderBrush="{DynamicResource BorderMid}" BorderThickness="1" Background="{DynamicResource SurfaceMid}" Margin="10,0,0,0">
                        <Border.Effect><DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="0" Opacity="0.3"/></Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                          <Border Width="40" Height="40" CornerRadius="8" Background="#FFF5F5FA" Margin="0,0,0,8" BorderBrush="#FFE2E2EA" BorderThickness="1">
                            <Border Width="20" Height="20" CornerRadius="4" Background="#FF2A2A32" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <TextBlock x:Name="TxtThemeWhiteLabel" Text="White" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                      </Border>
                    </StackPanel>

                    <!-- Task 4: Custom background (photo or video) -->
                    <Border Background="{DynamicResource SurfaceLow}" CornerRadius="10" Padding="14,12" Margin="0,16,0,0" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                      <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                          <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentFg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <TextBlock x:Name="TxtSettingBg" Text="Custom Background" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtSettingBgDesc" Text="Pick your own photo or video as the app background. The image/video is overlaid with a dark veil so text stays readable. Video formats: MP4, WebM, AVI, WMV." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock x:Name="LblBgPath" Text="No background selected." FontSize="10" Foreground="{DynamicResource FgMuted}" FontFamily="Consolas" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal">
                          <Button x:Name="BtnBgImage" FontFamily="Segoe UI" Style="{StaticResource BtnSec}" Content="&#xE8B9;  Choose Image" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
                          <Button x:Name="BtnBgVideo" FontFamily="Segoe UI" Style="{StaticResource BtnSec}" Content="&#xE8B2;  Choose Video" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
                          <Button x:Name="BtnBgClear" FontFamily="Segoe UI" Style="{StaticResource BtnSec}" Content="&#xE74D;  Clear" Padding="14,8" Cursor="Hand"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </Border>

                <!-- Data Management Card -->
                <Border CornerRadius="18" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="24" Margin="0,0,0,20" Background="{DynamicResource SurfaceGlass}">
                  <StackPanel>
                    <TextBlock x:Name="TxtSettingData" Text="Data Management" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" Margin="0,0,0,20"/>
                    
                    <TextBlock x:Name="TxtSettingDataSub" Text="Export &amp; Import Settings" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSettingDataDesc" Text="Export your settings and data to a portable backup file, or import settings from a previous backup. This includes your optimization states, favorites, theme preferences, and all app data." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="BtnExport" Style="{StaticResource BtnPri}" Content="Export Settings" Margin="0,0,10,0" Padding="16,8" Cursor="Hand" />
                      <Button x:Name="BtnImport" Style="{StaticResource BtnPri}" Content="Import Settings" Margin="0,0,10,0" Padding="16,8" Cursor="Hand" />
                      <Button x:Name="BtnOpenFolder" Style="{StaticResource BtnPri}" Content="Open Folder" Margin="0,0,10,0" Padding="16,8" Cursor="Hand" />
                      <Button x:Name="BtnDefender" Style="{StaticResource BtnPri}" Content="Defender / SmartScreen" Padding="16,8" Cursor="Hand" ToolTip="Add this app to Windows Defender exclusions and unblock SmartScreen warnings" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <!-- System Flashback Card -->
                <Border CornerRadius="18" BorderBrush="{DynamicResource BorderMid}" BorderThickness="1" Padding="24" Margin="0,0,0,20" Background="{DynamicResource SurfaceGlass}">
                  <Border.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="1" Opacity="0.08"/>
                  </Border.Effect>
                  <StackPanel>
                    <TextBlock x:Name="TxtFlashbackHeader" Text="System Flashback" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" Margin="0,0,0,20"/>
                    
                    <TextBlock x:Name="TxtFlashbackTitle" Text="Create &amp; Rollback Snapshots" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtFlashbackDesc" Text="System Flashback utilizes Windows System Restore points. It creates a snapshot of critical system files, the registry, and driver configurations. In case of system instability or if you wish to revert modifications, this feature rolls back the operating system to its pre-optimization state without affecting your personal files (such as documents or photos)." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    
                    <!-- Flashback Creation Mode -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFlashbackModeTitle" Text="Manual Registry Backup" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtFlashbackModeDesc" Text="Force local file-based registry backups (.nvnbak) instead of Windows System Restore points. Recommended if System Restore is disabled or slow." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglFlashbackMode" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="BtnCreateRestorePoint" Style="{StaticResource BtnAccent}" Margin="0,0,10,0" Padding="16,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                          <TextBlock x:Name="TxtCreateRestorePointLabel" Text="Create Flashback Point" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="BtnRestoreSystem" Style="{StaticResource BtnAccent}" Padding="16,8" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                          <TextBlock x:Name="TxtRestoreSystemLabel" Text="Rollback (Flashback)" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>

                    <!-- Local Backups List -->
                    <TextBlock x:Name="LocalBackupsHeader" Text="Local Backups (Last 5)" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}" Margin="0,20,0,8" Visibility="Collapsed"/>
                    <StackPanel x:Name="LocalBackupsContainer"/>
                  </StackPanel>
                </Border>

                 <!-- Application Behavior Card -->
                <Border CornerRadius="18" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="24" Margin="0,0,0,20" Background="{DynamicResource SurfaceGlass}">
                  <StackPanel>
                    <TextBlock x:Name="TxtSettingBehavior" Text="Application Behavior" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" Margin="0,0,0,20"/>

                    <!-- v2.8: Admin Status row -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAdminStatusTitle" Text="Administrator" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtAdminStatusDesc" Text="Tweaks require admin privileges. Restart elevated to apply optimizations." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <Button x:Name="BtnRestartAdmin" Grid.Column="2" Style="{StaticResource BtnSec}" Content="&#xE7E8;  Restart as Admin" Padding="14,6" Cursor="Hand" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Start with Windows -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAutoStartTitle" Text="Start with Windows" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtAutoStartDesc" Text="Automatically launch the application when Windows starts, ensuring system optimization runs in the background from the moment you log in" FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglAutoStart" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>


                    <!-- Ask before closing -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAskCloseTitle" Text="Show confirmation prompts" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtAskCloseDesc" Text="Displays a Yes/No warning box before starting the application of tweaks to avoid accidental changes." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglAskClose" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Create Restore Point -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtRestorePointTitle" Text="Create restore point automatically" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtRestorePointDesc" Text="Creates a System Restore Point automatically before applying or undoing any tweaks." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglRestorePoint" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- v1.4: Skip Restore Points (with confirmation warning) -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" Foreground="#EF4444" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSkipRestorePointTitle" Text="Skip restore points (DANGER)" FontSize="12" FontWeight="SemiBold" Foreground="#EF4444"/>
                        <TextBlock x:Name="TxtSkipRestorePointDesc" Text="Disables automatic restore point creation. Tweaks will apply faster but you lose the ability to roll back. Enable at your own risk." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglSkipRestorePoint" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Auto Restart -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAutoRestartTitle" Text="Automatically restart if a tweak requires it" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtAutoRestartDesc" Text="Automatically reboots the computer if any of the applied tweaks require a reboot." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglAutoRestart" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Sound Effects -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE799;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSoundsTitle" Text="Sound Effects" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtSoundsDesc" Text="Enable click, hover, and toggle sounds throughout the application. Disable for a silent experience." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglSounds" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Animations -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAnimationsTitle" Text="UI Animations" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtAnimationsDesc" Text="Enable smooth transitions, hover effects, and entrance animations. Disable for instant response (better on low-end hardware)." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglAnimations" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Hardware Acceleration -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtHwAccelTitle" Text="Hardware Acceleration" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtHwAccelDesc" Text="Use GPU hardware rendering for the UI. Reduces CPU usage and improves responsiveness. Disable if you experience graphical glitches or the app runs on a system without a dedicated GPU." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglHwAccel" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Auto Update Check -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xECC5;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtAutoUpdateTitle" Text="Check for Updates on Startup" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtAutoUpdateDesc" Text="Automatically check for newer versions of NoveN Tweaks when the application starts. Shows a notification if an update is available." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglAutoUpdate" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Compact Mode -->
                    <Grid Margin="0,0,0,20">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE73F;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgMuted}" FontSize="16" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtCompactTitle" Text="Compact Mode" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}"/>
                        <TextBlock x:Name="TxtCompactDesc" Text="Reduce padding and card sizes to fit more tweaks on screen. Useful for smaller displays or laptops." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                      </StackPanel>
                      <CheckBox x:Name="TglCompact" Grid.Column="2" Style="{StaticResource ToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>

                  </StackPanel>
                </Border>

                <!-- Reset Settings Card -->
                <Border CornerRadius="18" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="24" Margin="0,0,0,20" Background="{DynamicResource SurfaceGlass}">
                  <StackPanel>
                    <TextBlock x:Name="TxtSettingReset" Text="Reset Settings" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" Margin="0,0,0,8"/>
                    <TextBlock x:Name="TxtSettingResetSub" Text="Reset All Application Settings" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgHigh}" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtSettingResetDesc" Text="Resets all app appearance and behavior settings (theme, sounds, animations, toggles, etc.) back to their defaults. This does NOT affect any applied Windows tweaks." FontSize="11" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Button x:Name="BtnResetSettings" FontFamily="Segoe UI" Style="{StaticResource BtnSec}" Content="&#xE72C;  Reset All Settings" Padding="16,8" HorizontalAlignment="Left" Cursor="Hand"/>
                  </StackPanel>
                </Border>



                <!-- License Card (delete key option + key display removed per user request) -->
                <Border CornerRadius="18" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="24" Margin="0,0,0,20" Background="{DynamicResource SurfaceGlass}">
                  <StackPanel>
                    <TextBlock x:Name="TxtSettingsLicenseHeader" Text="Local access" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" Margin="0,0,0,16"/>
                    <Grid Margin="0,0,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" Foreground="#22C55E" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="LblLicenseStatus" Text="Local access" FontSize="12" FontWeight="SemiBold" Foreground="#22C55E"/>
                        <TextBlock x:Name="LblLicenseStatusSub" Text="Works offline. No license server." FontSize="10" Foreground="{DynamicResource FgMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="Autorzy: xolyazz &amp; Kl3ban" FontSize="10" Foreground="{DynamicResource FgMuted}" Margin="0,8,0,0"/>
                        <TextBlock Text="github.com/xolyazz · github.com/Kl3ban" FontSize="10" Foreground="{DynamicResource FgMuted}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- ===== FOOTER ===== -->
        <Border Grid.Row="2" Height="46" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16">
          <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
              <GradientStop Color="#0AFFFFFF" Offset="0"/>
              <GradientStop Color="#04FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Border.Background>
          <Grid Margin="18,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterStatus" Grid.Column="0"
                       VerticalAlignment="Center" FontSize="10"
                       FontFamily="Consolas" Foreground="{DynamicResource FgFaint}" Visibility="Collapsed"/>
            <Button x:Name="BtnUndo"  Grid.Column="1" Style="{StaticResource BtnSec}" Margin="0,0,7,0"/>
            <Button x:Name="BtnApply" Grid.Column="2" Style="{StaticResource BtnPri}" Margin="0,0,0,0"/>
            <Button x:Name="BtnInstall" Grid.Column="2" Style="{StaticResource BtnPri}" Visibility="Collapsed" Margin="0,0,0,0"/>
            <Button x:Name="BtnDownload" Grid.Column="3" Style="{StaticResource BtnSec}" Visibility="Collapsed"/>
            <!-- (button contents are localised at runtime via ApplyLanguage()) -->
          </Grid>
        </Border>

        <!-- ===== SMART OPTIMIZER WIZARD ===== -->
        <Grid x:Name="WizardOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="140">
          <Border CornerRadius="16" Background="#D8050505"/>
          <Border x:Name="WizardBox" CornerRadius="14" Width="760" Height="500" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="30,30,30,30" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                  Background="{DynamicResource OverlayBg}">
            <Border.CacheMode><BitmapCache EnableClearType="False" RenderAtScale="1"/></Border.CacheMode>
            
            <Grid>
              <!-- STEP 2: Scanning -->
              <StackPanel x:Name="WizStep2" Visibility="Collapsed" VerticalAlignment="Center" Width="400">
                <TextBlock x:Name="WizStatusMain" Text="Scanning system..." FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="WizStatusSub" Text="Analyzing configuration" FontSize="11" Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center" Margin="0,8,0,25" FontFamily="Segoe UI"/>
                <Border Background="{DynamicResource SurfaceHigh}" CornerRadius="3" Height="4" Width="400">
                  <Border x:Name="WizProgressBar" Background="{DynamicResource Accent}" CornerRadius="3" Width="0" HorizontalAlignment="Left" />
                </Border>
              </StackPanel>

              <!-- STEP 3: Results -->
              <Grid x:Name="WizStep3" Visibility="Collapsed">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock x:Name="TxtScanComplete" Text="Scan Complete" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" Margin="0,0,0,15"/>
                
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15" Padding="0,0,10,0">
                  <StackPanel>
                    <TextBlock x:Name="TxtScanRecommended" Text="Recommended to Apply" FontSize="14" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="WizRecommendedList">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    
                    <TextBlock x:Name="TxtScanAlreadyApplied" Text="Already Applied" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Margin="0,20,0,10"/>
                    <ItemsControl x:Name="WizAlreadyAppliedList">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock x:Name="TxtScanAdvanced" Text="Advanced (use with caution)" FontSize="14" FontWeight="SemiBold" Foreground="#EAB308" Margin="0,20,0,4"/>
                    <TextBlock x:Name="TxtScanAdvancedHint" Text="" FontSize="10" Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="WizAdvancedList">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="WizStats" VerticalAlignment="Center" Foreground="{DynamicResource FgMid}" FontSize="12"/>
                  <Button x:Name="BtnWizCancel3" Grid.Column="1" Style="{StaticResource BtnSec}" Content="Cancel" Margin="0,0,10,0"/>
                  <Button x:Name="BtnWizApply" Grid.Column="2" Style="{StaticResource BtnPri}" Content="Apply Recommendations"/>
                </Grid>
              </Grid>
            </Grid>
          </Border>
        </Grid>

        <!-- ===== ASYNC LOADING OVERLAY (full-window, appears during Apply/Undo) ===== -->
        <Grid x:Name="LoadingOverlay" Grid.Row="0" Grid.RowSpan="3"
              Visibility="Collapsed" Panel.ZIndex="150">
          <Border CornerRadius="16" Background="#CC030303"/>
          <Border x:Name="LoadingBox" CornerRadius="12" Width="340" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="36,30,36,26" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                  Background="{DynamicResource OverlayBg}">
            <Border.CacheMode><BitmapCache EnableClearType="False" RenderAtScale="1"/></Border.CacheMode>
            <StackPanel HorizontalAlignment="Center">
              <TextBlock x:Name="OverlaySpinner" Text="?" FontSize="28"
                         Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"
                         FontFamily="Segoe UI" Margin="0,0,0,12"/>
              <TextBlock x:Name="OverlayTitleLbl" Text="Applying tweaks"
                         FontSize="14" FontWeight="SemiBold"
                         Foreground="{DynamicResource FgPrimary}" HorizontalAlignment="Center"
                         Margin="0,0,0,6"/>
              <TextBlock x:Name="OverlayStatusLbl" Text=""
                         FontSize="10" FontFamily="Segoe UI"
                         Foreground="{DynamicResource FgMuted}" HorizontalAlignment="Center"
                         TextWrapping="Wrap" MaxWidth="268"
                         Margin="0,0,0,20"/>
              <Grid Width="268" Height="4" Margin="0,0,0,8">
                <Rectangle Fill="{DynamicResource SurfaceMid}" RadiusX="2" RadiusY="2"/>
                <Rectangle x:Name="OverlayProgressFill" Fill="{DynamicResource Accent}" RadiusX="2" RadiusY="2"
                           HorizontalAlignment="Left" Width="0"/>
              </Grid>
              <TextBlock x:Name="OverlayCounter" Text="0 / 0"
                         FontSize="9" FontFamily="Segoe UI"
                         Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center"
                         Margin="0,3,0,0"/>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ===== WIZARD LEVEL CHOICE OVERLAY (v2.8: clean, minimalist) ===== -->
        <Grid x:Name="WizLevelsOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="150" Opacity="0">
          <Border x:Name="WizLevelsScrim" CornerRadius="16" Background="#B4030303"/>
          <Border x:Name="WizLevelsBox" CornerRadius="12" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="0" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <TranslateTransform x:Name="WizLevelsBoxTranslate" Y="24"/>
            </Border.RenderTransform>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- v2.8: Simple flat header — no gradient, no orb, no glow -->
              <Border Grid.Row="0" Background="Transparent" CornerRadius="12,12,0,0" Padding="24,22,24,16">
                <StackPanel>
                  <TextBlock x:Name="TxtWizLevelTitle" Text="Choose Optimization Level" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center" Margin="0,0,0,4"/>
                  <TextBlock x:Name="TxtWizLevelSubtitle" Text="Select a profile to apply recommended tweaks." FontSize="11" Foreground="{DynamicResource FgMuted}"/>
                </StackPanel>
              </Border>

              <!-- Body: cards -->
              <Border Grid.Row="1" Background="Transparent" Padding="20,16,20,16">
                <StackPanel>

                  <!-- Minimal Card -->
                  <Button x:Name="BtnWizMin" Style="{StaticResource WizMinBtnStyle}">
                    <Button.Content>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- v2.8: Simple flat icon badge — no gradient -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center" Background="#142922" BorderBrush="#1F3A30" BorderThickness="1">
                          <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#34D399" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock x:Name="TxtWizMinTitle" Text="Minimal" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                            <Border CornerRadius="3" Background="#142922" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#1F3A30" BorderThickness="1">
                              <TextBlock Text="SAFE" FontSize="8" FontWeight="SemiBold" Foreground="#34D399"/>
                            </Border>
                          </StackPanel>
                          <TextBlock x:Name="TxtWizMinDesc" Text="~12 safe tweaks · Privacy &amp; background processes" FontSize="10" Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- Arrow -->
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#34D399" VerticalAlignment="Center" Opacity="0.4" Margin="8,0,0,0"/>
                      </Grid>
                    </Button.Content>
                  </Button>

                  <!-- Normal Card -->
                  <Button x:Name="BtnWizStd" Style="{StaticResource WizStdBtnStyle}">
                    <Button.Content>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center" Background="#101E36" BorderBrush="#1A2A48" BorderThickness="1">
                          <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock x:Name="TxtWizStdTitle" Text="Normal" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                            <Border CornerRadius="3" Background="#101E36" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#1A2A48" BorderThickness="1">
                              <TextBlock Text="RECOMMENDED" FontSize="8" FontWeight="SemiBold" Foreground="#60A5FA"/>
                            </Border>
                          </StackPanel>
                          <TextBlock x:Name="TxtWizStdDesc" Text="Balanced · Gaming &amp; latency tweaks · Most users" FontSize="10" Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#60A5FA" VerticalAlignment="Center" Opacity="0.4" Margin="8,0,0,0"/>
                      </Grid>
                    </Button.Content>
                  </Button>

                  <!-- FullOpti Card -->
                  <Button x:Name="BtnWizFull" Style="{StaticResource WizFullBtnStyle}" Margin="0">
                    <Button.Content>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Margin="0,0,12,0" VerticalAlignment="Center" Background="#2A1E08" BorderBrush="#3D2C10" BorderThickness="1">
                          <TextBlock Text="&#xE9E9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock x:Name="TxtWizFullTitle" Text="FullOpti" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                            <Border CornerRadius="3" Background="#2A1E08" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center" BorderBrush="#3D2C10" BorderThickness="1">
                              <TextBlock Text="MAX" FontSize="8" FontWeight="SemiBold" Foreground="#F59E0B"/>
                            </Border>
                          </StackPanel>
                          <TextBlock x:Name="TxtWizFullDesc" Text="All tweaks · Advanced users · May be aggressive" FontSize="10" Foreground="{DynamicResource FgMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#F59E0B" VerticalAlignment="Center" Opacity="0.4" Margin="8,0,0,0"/>
                      </Grid>
                    </Button.Content>
                  </Button>

                </StackPanel>
              </Border>

              <!-- Footer -->
              <Border Grid.Row="2" Background="Transparent" CornerRadius="0,0,12,12" Padding="20,14">
                <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSoft}">
                  <Grid>
                    <TextBlock x:Name="TxtWizFooterNote" Text="Changes can be reverted anytime via Flashback" FontSize="10" Foreground="{DynamicResource FgFaint}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    <Button x:Name="BtnWizCloseOverlay" HorizontalAlignment="Right" Style="{StaticResource BtnSec}" Content="Cancel" Padding="22,8" MinWidth="80" Cursor="Hand"/>
                  </Grid>
                </Border>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- ===== DIALOG OVERLAY (Apple-style: frosted scrim, slide+fade in) ===== -->
        <Grid x:Name="DialogOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="500" Opacity="0">
          <Border x:Name="DialogScrim" CornerRadius="16" Background="#B4030303"/>
          <Border x:Name="DialogBox" CornerRadius="18" Width="480" MaxHeight="600" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="0" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource BorderMid}" BorderThickness="1"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <TranslateTransform x:Name="DialogBoxTranslate" Y="24"/>
            </Border.RenderTransform>
            <Border.CacheMode><BitmapCache EnableClearType="False" RenderAtScale="1"/></Border.CacheMode>
            <Border.Effect>
              <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#000000" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Header banner (neutral gray) -->
              <Border x:Name="DialogHeaderBanner" Grid.Row="0" Background="Transparent" CornerRadius="18,18,0,0" Padding="28,24,28,12">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="DialogIcon" FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="28" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <TextBlock x:Name="DialogTitle" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <!-- Body content (scrollable for long messages) -->
              <ScrollViewer Grid.Row="1" Padding="28,8,28,24" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="DialogMessage" FontSize="13" Foreground="{DynamicResource FgHigh}" TextWrapping="Wrap" LineHeight="20"/>
              </ScrollViewer>

              <!-- Footer action bar (transparent background, subtle top divider) -->
              <Border Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="28,16" CornerRadius="0,0,18,18">
                <StackPanel x:Name="DialogButtons" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="BtnDialogYes" Style="{StaticResource BtnPri}" Content="Yes" Margin="0,0,10,0" Padding="22,8" MinWidth="80" Visibility="Collapsed"/>
                  <Button x:Name="BtnDialogNo" Style="{StaticResource BtnSec}" Content="No" Margin="0,0,10,0" Padding="22,8" MinWidth="80" Visibility="Collapsed"/>
                  <Button x:Name="BtnDialogOK" Style="{StaticResource BtnPri}" Content="OK" Padding="22,8" MinWidth="80" Visibility="Collapsed"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- ===== BLOATWARE APP-PICKER OVERLAY (auto-detect + checkbox list) ===== -->
        <Grid x:Name="AppPickerOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="250" Opacity="0">
          <Border x:Name="AppPickerScrim" CornerRadius="16" Background="#B4030303"/>
          <Border x:Name="AppPickerBox" CornerRadius="18" Width="560" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="0" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource BorderMid}" BorderThickness="1"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <TranslateTransform x:Name="AppPickerTranslate" Y="24"/>
            </Border.RenderTransform>
            <Border.CacheMode><BitmapCache EnableClearType="False" RenderAtScale="1"/></Border.CacheMode>
            <Border.Effect>
              <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#000000" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Header (neutral gray) -->
              <Border Grid.Row="0" Background="Transparent" CornerRadius="18,18,0,0" Padding="24,20,24,14">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="20" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="AppPickerTitle" Text="Select Apps to Remove" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource FgPrimary}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="AppPickerSubtitle" Text="Detecting installed applications..." FontSize="11" Foreground="{DynamicResource FgMuted}" Margin="30,2,0,0"/>
                </StackPanel>
              </Border>

              <!-- Body: scrollable checkbox list -->
              <Border Grid.Row="1" Background="Transparent">
                <ScrollViewer x:Name="AppPickerScroll" VerticalScrollBarVisibility="Auto" Padding="20,16">
                  <StackPanel x:Name="AppPickerList"/>
                </ScrollViewer>
              </Border>

              <!-- Footer: select all / remove / cancel -->
              <Border Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="24,14" CornerRadius="0,0,18,18">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BtnAppPickerSelectAll" Grid.Column="0" Style="{StaticResource BtnSec}" Content="Select All" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
                  <TextBlock x:Name="AppPickerCount" Grid.Column="1" FontSize="11" Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <Button x:Name="BtnAppPickerCancel" Grid.Column="2" Style="{StaticResource BtnSec}" Content="Cancel" Padding="14,8" Margin="0,0,8,0" Cursor="Hand"/>
                  <Button x:Name="BtnAppPickerRemove" Grid.Column="3" Style="{StaticResource BtnPri}" Content="Remove Selected" Padding="14,8" Cursor="Hand"/>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- Local welcome screen -->
        <Grid x:Name="LicenseOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="350">
          <Border CornerRadius="16" Background="#B4030303"/>
          <Border x:Name="LicenseBox" CornerRadius="18" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="44,38,44,38" Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource BorderMid}" BorderThickness="1">
            <Border.CacheMode><BitmapCache EnableClearType="False" RenderAtScale="1"/></Border.CacheMode>
            <Border.Effect>
              <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#000000" Opacity="0.95"/>
            </Border.Effect>
            <StackPanel>
              <!-- Icon + Title -->
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8D7;" FontSize="46" HorizontalAlignment="Center" Margin="0,0,0,14"
                         Foreground="#A1A1AA"/>
              <TextBlock x:Name="TxtLicenseActivation" Text="Welcome" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource FgPrimary}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
              <TextBlock x:Name="TxtLicensePrompt" Text="Enter any text to open the app." FontSize="12" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,28" MaxWidth="360"/>

              <!-- Key input area -->
              <Border CornerRadius="10" Background="{DynamicResource SurfaceLow}" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="16,10" Margin="0,0,0,10">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource FgFaint}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBox x:Name="TxtLicenseKey" Grid.Column="1"
                           Background="Transparent" BorderThickness="0"
                           Foreground="{DynamicResource FgPrimary}" FontSize="15" FontFamily="Consolas"
                           CaretBrush="#A1A1AA" SelectionBrush="#30A1A1AA"
                           VerticalAlignment="Center"
                           MaxLength="0"
                           CharacterCasing="Normal"
                           ToolTip="Enter any text"/>
                </Grid>
              </Border>

              <!-- Placeholder hint -->
              <TextBlock x:Name="TxtLicenseFormat" Text="Any text — no key or internet required." FontSize="10" Foreground="{DynamicResource FgFaint}" HorizontalAlignment="Center" Margin="0,0,0,6" FontFamily="Consolas"/>

              <!-- Status label -->
              <TextBlock x:Name="LblLicenseError" Text="" FontSize="11" Foreground="#F87171" HorizontalAlignment="Center" Margin="0,0,0,16" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"/>

              <!-- Activate button -->
              <Button x:Name="BtnActivateLicense" Style="{StaticResource BtnPri}" Content="Continue" Height="42" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
               <!-- ===== DISCLAIMER OVERLAY (v2.3 redesigned) ===== -->
        <Grid x:Name="DisclaimerOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="300">
          <Border CornerRadius="16" Background="#B4030303"/>
          <Border x:Name="DisclaimerBox" CornerRadius="16" Width="680" MaxHeight="700" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="0" Background="{DynamicResource OverlayBg}" BorderBrush="#3F3F46" BorderThickness="1">
            <Border.CacheMode><BitmapCache EnableClearType="False" RenderAtScale="1"/></Border.CacheMode>
            <Border.Effect>
              <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#000000" Opacity="0.95"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Top warning banner (neutral dark gray) -->
              <Border Grid.Row="0" Background="Transparent" CornerRadius="16,16,0,0" Padding="24,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock x:Name="TxtDisclaimerTitle" Text="Important Disclaimer" FontSize="20" FontWeight="Bold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- Body content -->
              <ScrollViewer Grid.Row="1" Padding="32,24" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                <StackPanel>
                  <!-- Body1 - main warning -->
                  <TextBlock x:Name="TxtDisclaimerBody1" Text="WARNING: NoveN Tweaks is an advanced system optimization tool that modifies core Windows registry keys, critical services, and deeply integrated system components. These changes are intended for advanced users only."
                             FontSize="13.5" Foreground="{DynamicResource FgPrimary}" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Left" Margin="0,0,0,16" LineHeight="20"/>

                  <!-- Separator -->
                  <Border Height="1" Background="#3F3F46" Margin="0,0,0,16"/>

                  <!-- Risk paragraphs -->
                  <StackPanel Margin="0,0,0,16">
                    <!-- Risk 1 -->
                    <TextBlock x:Name="TxtDisclaimerRisk1" Text="System Instability: Applying incorrect tweaks may result in Blue Screens of Death (BSOD), unexpected crashes, or failure to boot."
                               FontSize="13" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" TextAlignment="Left" LineHeight="20" Margin="0,0,0,12"/>
                               
                    <!-- Risk 2 -->
                    <TextBlock x:Name="TxtDisclaimerRisk2" Text="Feature Loss: Certain apps, games, or Windows features (like Microsoft Store, Xbox services, or printers) may stop working entirely."
                               FontSize="13" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" TextAlignment="Left" LineHeight="20" Margin="0,0,0,12"/>
                               
                    <!-- Risk 3 -->
                    <TextBlock x:Name="TxtDisclaimerRisk3" Text="Data Corruption: While rare, severe system corruption could lead to data loss. Always back up your important files."
                               FontSize="13" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" TextAlignment="Left" LineHeight="20"/>
                  </StackPanel>

                  <!-- Separator -->
                  <Border Height="1" Background="#3F3F46" Margin="0,0,0,16"/>

                  <!-- Body2 - risk acknowledgment -->
                  <TextBlock x:Name="TxtDisclaimerBody2" Text="By proceeding, you acknowledge that you fully understand the consequences. It is strongly recommended to use the Flashback feature to create a safety net."
                             FontSize="13" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" TextAlignment="Left" LineHeight="20" Margin="0,0,0,16"/>

                  <!-- Liability box (distinct visual treatment) -->
                  <Border Background="#18181B" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <StackPanel>
                      <TextBlock Text="LIMITATION OF LIABILITY" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,8"/>
                      <TextBlock x:Name="TxtDisclaimerBody3" Text="NoveN.pl and the author of this software take ABSOLUTELY NO RESPONSIBILITY for any system damage, data loss, hardware issues, or other malfunctions resulting from the use of NoveN Tweaks. You are using this software entirely at your own risk."
                                 FontSize="11" Foreground="#A1A1AA" TextWrapping="Wrap" TextAlignment="Left" LineHeight="16"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </ScrollViewer>

              <!-- Bottom action bar -->
              <Border Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="28,16" CornerRadius="0,0,16,16">
                <StackPanel>
                  <CheckBox x:Name="ChkDisclaimerConfirm" HorizontalAlignment="Center" Margin="0,0,0,12"
                            Style="{StaticResource ToggleStyle}" ClickMode="Press">
                    <CheckBox.Content>
                      <TextBlock x:Name="TxtDisclaimerCheckbox" Text="I have read and understand the above" FontSize="12" Foreground="{DynamicResource FgMid}" Margin="8,0,0,0"/>
                    </CheckBox.Content>
                  </CheckBox>
                  <Button x:Name="BtnDisclaimerAccept" Style="{StaticResource BtnPri}" Content="I Understand and Accept" Height="42" FontSize="14" FontWeight="SemiBold" IsEnabled="False"/>
                </StackPanel>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- ===== POST-WARNING FLASHBACK CREATION OVERLAY (v2.6) ===== -->
        <Grid x:Name="FlashbackPromptOverlay" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="310">
          <Border CornerRadius="16" Background="#B4030303"/>
          <Border x:Name="FlashbackPromptBox" CornerRadius="16" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                  Padding="0" Background="{DynamicResource OverlayBg}" BorderBrush="#3F3F46" BorderThickness="1">
            <Border.CacheMode><BitmapCache EnableClearType="False" RenderAtScale="1"/></Border.CacheMode>
            <Border.Effect>
              <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#000000" Opacity="0.95"/>
            </Border.Effect>
            <Border.RenderTransform>
              <TranslateTransform x:Name="FlashbackPromptTranslate" Y="0"/>
            </Border.RenderTransform>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Top banner (neutral dark gray) -->
              <Border Grid.Row="0" Background="Transparent" CornerRadius="16,16,0,0" Padding="24,18">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock x:Name="TxtFlashbackPromptTitle" Text="Create a Safety Flashback" FontSize="20" FontWeight="Bold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>

              <!-- Body content -->
              <ScrollViewer Grid.Row="1" Padding="28,20" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock x:Name="TxtFlashbackPromptDesc"
                             Text="Before you start tweaking, we strongly recommend creating a Flashback restore point. This allows you to safely undo all changes if anything goes wrong."
                             FontSize="13" Foreground="{DynamicResource FgMid}" TextWrapping="Wrap" TextAlignment="Left" LineHeight="20" Margin="0,0,0,6"/>
                </StackPanel>
              </ScrollViewer>

              <!-- Bottom action bar -->
              <Border Grid.Row="2" Background="Transparent" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0" Padding="28,16" CornerRadius="0,0,16,16">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <!-- Skip button -->
                  <Button x:Name="BtnFlashbackPromptSkip" Grid.Column="0" Style="{StaticResource BtnSec}" Height="42" FontSize="13" FontWeight="SemiBold"
                          Content="No Thanks" Cursor="Hand"/>
                  <!-- Create button -->
                  <Button x:Name="BtnFlashbackPromptCreate" Grid.Column="2" Style="{StaticResource BtnPri}" Height="42" FontSize="13" FontWeight="SemiBold"
                          Content="Create Flashback Now"/>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>

        <!-- ===== LANGUAGE SELECTOR POPUP MODAL ===== -->
        <Grid x:Name="LanguageModal" Grid.Row="0" Grid.RowSpan="3" Visibility="Collapsed" Panel.ZIndex="9900" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <!-- Deep black backdrop overlay -->
          <Border Background="#F2000000" MouseDown="OnLanguageModalClose"/>
          
          <!-- Ultra-Minimalist Solid Black Modal Dialog Window -->
          <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="440" CornerRadius="16" Padding="24,22"
                  Background="#08080A" BorderBrush="#1F2128" BorderThickness="1">
            <Border.Effect>
              <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#000000" Opacity="0.98"/>
            </Border.Effect>
            <StackPanel>
              <!-- Minimal Header -->
              <Grid Margin="4,0,4,18">
                <TextBlock x:Name="TxtLangModalTitle" Text="Language / Język" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                <Button Click="OnLanguageModalClose" HorizontalAlignment="Right" VerticalAlignment="Center" Width="28" Height="28" Cursor="Hand" Background="Transparent" BorderThickness="0">
                  <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#6B7280"/>
                </Button>
              </Grid>

              <!-- Language Buttons Grid (3 columns, sleek minimal dark pills) -->
              <UniformGrid Columns="3">
                <Button Click="OnSelectLanguagePill" Tag="1" Margin="4" Padding="12,12" Cursor="Hand" Background="#111216" BorderBrush="#1E2028" BorderThickness="1">
                  <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                  </Button.Resources>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="PL" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Polski" FontSize="11" FontWeight="Normal" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Click="OnSelectLanguagePill" Tag="0" Margin="4" Padding="12,12" Cursor="Hand" Background="#111216" BorderBrush="#1E2028" BorderThickness="1">
                  <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                  </Button.Resources>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="EN" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="English" FontSize="11" FontWeight="Normal" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Click="OnSelectLanguagePill" Tag="2" Margin="4" Padding="12,12" Cursor="Hand" Background="#111216" BorderBrush="#1E2028" BorderThickness="1">
                  <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                  </Button.Resources>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="DE" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Deutsch" FontSize="11" FontWeight="Normal" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Click="OnSelectLanguagePill" Tag="4" Margin="4" Padding="12,12" Cursor="Hand" Background="#111216" BorderBrush="#1E2028" BorderThickness="1">
                  <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                  </Button.Resources>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ES" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Español" FontSize="11" FontWeight="Normal" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Click="OnSelectLanguagePill" Tag="3" Margin="4" Padding="12,12" Cursor="Hand" Background="#111216" BorderBrush="#1E2028" BorderThickness="1">
                  <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                  </Button.Resources>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="FR" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Français" FontSize="11" FontWeight="Normal" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Click="OnSelectLanguagePill" Tag="5" Margin="4" Padding="12,12" Cursor="Hand" Background="#111216" BorderBrush="#1E2028" BorderThickness="1">
                  <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                  </Button.Resources>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="IT" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Italiano" FontSize="11" FontWeight="Normal" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Click="OnSelectLanguagePill" Tag="6" Margin="4" Padding="12,12" Cursor="Hand" Background="#111216" BorderBrush="#1E2028" BorderThickness="1">
                  <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                  </Button.Resources>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CZ" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Čeština" FontSize="11" FontWeight="Normal" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Click="OnSelectLanguagePill" Tag="7" Margin="4" Padding="12,12" Cursor="Hand" Background="#111216" BorderBrush="#1E2028" BorderThickness="1">
                  <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                  </Button.Resources>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="RU" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Русский" FontSize="11" FontWeight="Normal" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
                <Button Click="OnSelectLanguagePill" Tag="8" Margin="4" Padding="12,12" Cursor="Hand" Background="#111216" BorderBrush="#1E2028" BorderThickness="1">
                  <Button.Resources>
                    <Style TargetType="Border"><Setter Property="CornerRadius" Value="10"/></Style>
                  </Button.Resources>
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ZH" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                    <TextBlock Text="中文" FontSize="11" FontWeight="Normal" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                  </StackPanel>
                </Button>
              </UniformGrid>
            </StackPanel>
          </Border>
        </Grid>

        <!-- ===== TOAST NOTIFICATION OVERLAY (bottom-right corner) ===== -->
        <Grid Grid.Row="0" Grid.RowSpan="3" IsHitTestVisible="False">
          <StackPanel x:Name="ToastStack"
                      VerticalAlignment="Bottom" HorizontalAlignment="Right"
                      Margin="0,0,16,62" IsHitTestVisible="False"/>
        </Grid>

      </Grid>
    </Grid>
  </Border>
</Window>
