<Application x:Class="NoveNTweaks.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="src/MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!--
            ============================================================
            SEMANTIC THEME PALETTE  (Dark / Normal defaults)
            Every visible colour in the app binds to one of these via
            {DynamicResource Key}. SetTheme() swaps these brushes at
            runtime to switch between Dark / Normal / White themes.
            White theme uses opaque dark-on-light colours so text and
            icons stay readable on a white background.
            ============================================================
        -->
        <SolidColorBrush x:Key="RootBg"        Color="#0D0D10"/>
        <SolidColorBrush x:Key="BgVeil"        Color="#0D0D10"/>
        <SolidColorBrush x:Key="FgPrimary"     Color="#F0FFFFFF"/>
        <SolidColorBrush x:Key="FgHigh"        Color="#E0FFFFFF"/>
        <SolidColorBrush x:Key="FgMid"         Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="FgMuted"       Color="#60FFFFFF"/>
        <SolidColorBrush x:Key="FgFaint"       Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="FgIcon"        Color="#75FFFFFF"/>
        <SolidColorBrush x:Key="FgOnAccent"    Color="#FFFFFFFF"/>

        <SolidColorBrush x:Key="SurfaceLow"    Color="#0DFFFFFF"/>
        <SolidColorBrush x:Key="SurfaceMid"    Color="#10FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceHigh"   Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="SurfaceGlass"  Color="#0CFFFFFF"/>
        <SolidColorBrush x:Key="HoverBg"       Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="HoverBorder"   Color="#35FFFFFF"/>

        <SolidColorBrush x:Key="BorderSoft"    Color="#16FFFFFF"/>
        <SolidColorBrush x:Key="BorderMid"     Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="BorderStrong"  Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="BorderAccent"  Color="#B03B82F6"/>

        <SolidColorBrush x:Key="Accent"        Color="#3B82F6"/>
        <SolidColorBrush x:Key="AccentSoft"    Color="#203B82F6"/>
        <SolidColorBrush x:Key="AccentFg"      Color="#6B9CE8"/>

        <!-- Raw Color twins (used by GradientStop.Color bindings; kept in sync with brushes by ApplyPalette) -->
        <Color x:Key="AccentColor">#3B82F6</Color>
        <Color x:Key="AccentFgColor">#6B9CE8</Color>
        <Color x:Key="FgPrimaryColor">#F0FFFFFF</Color>
        <Color x:Key="FgMutedColor">#60FFFFFF</Color>

        <SolidColorBrush x:Key="PillBg"        Color="#E4FFFFFF"/>
        <SolidColorBrush x:Key="PillFg"        Color="#111111"/>
        <SolidColorBrush x:Key="PillHover"     Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="GhostFg"       Color="#90FFFFFF"/>
        <SolidColorBrush x:Key="GhostBorder"   Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="GhostHoverBg"  Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="GhostHoverBorder" Color="#55FFFFFF"/>
        <SolidColorBrush x:Key="GhostHoverFg"  Color="#D0FFFFFF"/>

        <SolidColorBrush x:Key="NavHoverBg"    Color="#0EFFFFFF"/>
        <SolidColorBrush x:Key="NavCheckedBg"  Color="#1CFFFFFF"/>

        <SolidColorBrush x:Key="WinBtnHoverBg" Color="#18FFFFFF"/>
        <SolidColorBrush x:Key="WinBtnHoverFg" Color="#A0FFFFFF"/>

        <SolidColorBrush x:Key="TrackOffBg"    Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="TrackOffBorder" Color="#50FFFFFF"/>
        <SolidColorBrush x:Key="KnobFill"      Color="#FFFFFF"/>

        <SolidColorBrush x:Key="ThumbBg"       Color="#40FFFFFF"/>
        <SolidColorBrush x:Key="ThumbHoverBg"  Color="#60FFFFFF"/>
        <SolidColorBrush x:Key="TrackLane"     Color="#0AFFFFFF"/>

        <SolidColorBrush x:Key="Shimmer"       Color="#70FFFFFF"/>
        <SolidColorBrush x:Key="Divider"       Color="#18FFFFFF"/>

        <SolidColorBrush x:Key="WarnYellow"    Color="#EAB308"/>
        <SolidColorBrush x:Key="WarnYellowBg"  Color="#15EAB308"/>
        <SolidColorBrush x:Key="DangerRed"     Color="#EF4444"/>

        <SolidColorBrush x:Key="Scrim"         Color="#D0030303"/>
        <SolidColorBrush x:Key="OverlayBg"     Color="#F21A1A1A"/>
        <SolidColorBrush x:Key="OverlayBorder" Color="#30FFFFFF"/>
        <SolidColorBrush x:Key="OverlayScrim"  Color="#D0030303"/>
        <SolidColorBrush x:Key="OverlayFaint"  Color="#38FFFFFF"/>
        <SolidColorBrush x:Key="OverlayMid"    Color="#80FFFFFF"/>
        <SolidColorBrush x:Key="OverlayPrimary" Color="#F0FFFFFF"/>
        <SolidColorBrush x:Key="OverlayHigh"   Color="#E0FFFFFF"/>
    </Application.Resources>
</Application>
